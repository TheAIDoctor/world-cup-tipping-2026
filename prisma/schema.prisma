generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  password             String?
  emailVerified        DateTime?
  image                String?
  role                 String                @default("player")
  isBot                Boolean               @default(false)
  createdAt            DateTime              @default(now())
  accounts             Account[]
  sessions             Session[]
  matchTips            MatchTip[]
  tournamentPrediction TournamentPrediction?
  topScorerPrediction  TopScorerPrediction?
  comments             Comment[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  flagEmoji   String
  group       String
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id                 String     @id @default(cuid())
  matchNumber        Int        @unique
  stage              String
  homeTeamId         String?
  awayTeamId         String?
  homeTeam           Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  // FINAL official result ONLY. Written exclusively from the official fixture
  // feed (a results feed — a score's presence there means the match is over)
  // or an admin override. Never written with a live/in-progress score. The
  // leaderboard, group standings, goalscorers, and bracket all key off these.
  homeScore          Int?
  awayScore          Int?
  // Live in-progress score for DISPLAY ONLY (sourced from Perplexity during a
  // match). Never used for points, standings, goalscorers, or bracket. Cleared
  // when the official final result lands. liveStatus is "live" while playing.
  liveHomeScore      Int?
  liveAwayScore      Int?
  liveStatus         String?
  // Penalty shootout scores (knockout only). Used to determine bracket winner
  // when 90' is drawn. Tips are scored against the 90' result only.
  penaltyHomeScore   Int?
  penaltyAwayScore   Int?
  date               DateTime
  // Host city (e.g. "Mexico City"), stadium (e.g. "Estadio Azteca") and
  // host country (one of "USA" / "Mexico" / "Canada" for 2026).
  city               String?
  venue              String?
  country            String?
  // Bracket lineage. On admin result save, the winner is written into
  // nextMatch.{home|away}TeamId per nextMatchSlot. For SF, the loser is
  // written into loserMatch (the 3rd-place playoff) per loserMatchSlot.
  nextMatchId        String?
  nextMatchSlot      String?
  nextMatch          Match?     @relation("NextMatch", fields: [nextMatchId], references: [id])
  feederMatches      Match[]    @relation("NextMatch")
  loserMatchId       String?
  loserMatchSlot     String?
  loserMatch         Match?     @relation("LoserMatch", fields: [loserMatchId], references: [id])
  loserFeederMatches Match[]    @relation("LoserMatch")
  tips               MatchTip[]
  goals              MatchGoal[]
  // Official bracket slot codes from the FIFA schedule (R32 only), e.g.
  // "1A" (Group A winner), "2B" (runner-up), "3ABCDF" (third-place pool).
  homeSlotCode       String?
  awaySlotCode       String?
}

// Master record of who scored in each match. Populated automatically once a
// match result is final and validated so the per-team goal counts sum to the
// official score. The Golden Boot standings (TopScorer) are derived from this
// table by aggregation — never fetched as a standalone list.
model MatchGoal {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerName String
  team       String
  goals      Int    @default(1)

  @@unique([matchId, playerName])
}

model MatchTip {
  id        String @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?
  user      User   @relation(fields: [userId], references: [id])
  match     Match  @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model TournamentPrediction {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  champion String
  runnerUp String
  third    String
  fourth   String
}

model TopScorerPrediction {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  scorer1 String
  scorer2 String
  scorer3 String
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
}

// Live Golden Boot tracker — admin updates goal tallies during the tournament.
// Shown as a public "Top 10 Scorers" leaderboard on the leaderboard page.
model TopScorer {
  id        String @id @default(cuid())
  name      String @unique
  team      String @default("")
  flagEmoji String @default("")
  goals     Int    @default(0)
}

// User-submitted bug reports. Stored in the DB so reports survive email
// delivery failures; shown to the admin in the admin panel.
model BugReport {
  id          String   @id @default(cuid())
  description String
  pageUrl     String   @default("")
  userAgent   String   @default("")
  reporter    String   @default("Anonymous")
  createdAt   DateTime @default(now())
}

// Single-row table storing the actual tournament outcome for scoring predictions.
// Admin sets this after each event resolves. Identified by a fixed id "singleton".
model TournamentResult {
  id         String  @id @default(cuid())
  champion   String?
  runnerUp   String?
  third      String?
  fourth     String?
  topScorer1 String?
  topScorer2 String?
  topScorer3 String?
}
