generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  name                 String?
  email                String                @unique
  emailVerified        DateTime?
  image                String?
  role                 String                @default("player")
  createdAt            DateTime              @default(now())
  accounts             Account[]
  sessions             Session[]
  matchTips            MatchTip[]
  tournamentPrediction TournamentPrediction?
  topScorerPrediction  TopScorerPrediction?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Team {
  id          String  @id @default(cuid())
  name        String  @unique
  code        String  @unique
  flagEmoji   String
  group       String
  homeMatches Match[] @relation("HomeTeam")
  awayMatches Match[] @relation("AwayTeam")
}

model Match {
  id                 String     @id @default(cuid())
  matchNumber        Int        @unique
  stage              String
  homeTeamId         String?
  awayTeamId         String?
  homeTeam           Team?      @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam           Team?      @relation("AwayTeam", fields: [awayTeamId], references: [id])
  homeScore          Int?
  awayScore          Int?
  // Penalty shootout scores (knockout only). Used to determine bracket winner
  // when 90' is drawn. Tips are scored against the 90' result only.
  penaltyHomeScore   Int?
  penaltyAwayScore   Int?
  date               DateTime
  // Host city (e.g. "Mexico City"), stadium (e.g. "Estadio Azteca") and
  // host country (one of "USA" / "Mexico" / "Canada" for 2026).
  city               String?
  venue              String?
  country            String?
  // Bracket lineage. On admin result save, the winner is written into
  // nextMatch.{home|away}TeamId per nextMatchSlot. For SF, the loser is
  // written into loserMatch (the 3rd-place playoff) per loserMatchSlot.
  nextMatchId        String?
  nextMatchSlot      String?
  nextMatch          Match?     @relation("NextMatch", fields: [nextMatchId], references: [id])
  feederMatches      Match[]    @relation("NextMatch")
  loserMatchId       String?
  loserMatchSlot     String?
  loserMatch         Match?     @relation("LoserMatch", fields: [loserMatchId], references: [id])
  loserFeederMatches Match[]    @relation("LoserMatch")
  tips               MatchTip[]
}

model MatchTip {
  id        String @id @default(cuid())
  userId    String
  matchId   String
  homeScore Int
  awayScore Int
  points    Int?
  user      User   @relation(fields: [userId], references: [id])
  match     Match  @relation(fields: [matchId], references: [id])

  @@unique([userId, matchId])
}

model TournamentPrediction {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id])
  champion String
  runnerUp String
  third    String
  fourth   String
}

model TopScorerPrediction {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  scorer1 String
  scorer2 String
  scorer3 String
}
